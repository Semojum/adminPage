# API 소스 선택: mock | http
#   mock : src/api/mock 의 목업 데이터를 사용합니다 (기본값)
#   http : src/api/http 의 실제 HTTP 구현을 사용합니다 (V3 API 명세)
VITE_API_SOURCE=mock

# VITE_API_SOURCE=http 일 때 붙일 서버.
#   경로는 명세 그대로 /api/... 를 쓰므로 여기에는 호스트만 적습니다.
#   운영 : https://api.semojum.app
#   개발 : 비워 두고 vite.config.ts 의 /api 프록시를 켭니다.
VITE_API_BASE_URL=https://api.semojum.app

# mock 모드에서 흉내낼 네트워크 지연(ms). 0 이면 즉시 응답합니다.
VITE_MOCK_LATENCY=250
